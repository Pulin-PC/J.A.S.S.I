<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is signed with Apple's hardened runtime. Without this line macOS refuses the
	     microphone without even asking, and listening (speech-to-text) cannot work. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
